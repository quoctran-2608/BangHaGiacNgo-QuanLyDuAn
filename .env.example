BOOTSTRAP_ADMIN_EMAIL=

# ==============================================================================
# TBHGN MCP Server V1.1 (Read-Only, Production Domain)
# ==============================================================================
MCP_ENABLED=true
MCP_PUBLIC_URL=https://duan.banghadengiacngo.io.vn/mcp
MCP_ALLOWED_HOSTS=duan.banghadengiacngo.io.vn
MCP_ALLOWED_ORIGINS=duan.banghadengiacngo.io.vn

# Giữ true nếu muốn kiểm thử trực tiếp bằng MCP Inspector + Firebase ID Token
MCP_ALLOW_FIREBASE_ID_TOKEN=true
MCP_OAUTH_REQUIRED_SCOPE=mcp:read

# OAuth 2.1 Authorization Server bên ngoài (KHÔNG đặt trùng domain TBHGN trừ khi tự vận hành IdP)
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=https://duan.banghadengiacngo.io.vn/mcp
# Tùy chọn: để trống sẽ tự khám phá jwks_uri từ OIDC/OAuth Discovery của MCP_OAUTH_ISSUER
MCP_OAUTH_JWKS_URI=

# Liên kết danh tính OAuth (issuer + sub) -> Firebase UID (KHÔNG ghép theo email)
# Giá trị hợp lệ: mapping_file (khuyến nghị) | idp_claim | both_strict
MCP_OAUTH_IDENTITY_LINK_MODE=mapping_file
# Đường dẫn tuyệt đối NGOÀI webroot, ví dụ: /etc/tbhgn/mcp-oauth-links.json (chmod 600)
MCP_OAUTH_UID_MAP_FILE=
# Tên claim do IdP ký nếu dùng idp_claim hoặc both_strict
MCP_OAUTH_UID_CLAIM=https://duan.banghadengiacngo.io.vn/firebase_uid

# Khuyến nghị giữ false để ChatGPT đọc Authorization Server Metadata trực tiếp từ IdP thật
MCP_OAUTH_PROXY_AS_METADATA=false

# Cầu nối đọc Firestore chỉ đọc (roles/datastore.viewer) cho OAuth JWT từ IdP ngoài
# Giá trị hợp lệ: disabled | service_account_file | metadata
MCP_FIRESTORE_BRIDGE_MODE=disabled
# Đường dẫn tuyệt đối NGOÀI webroot khi dùng service_account_file, ví dụ: /etc/tbhgn/firestore-readonly-sa.json
MCP_FIRESTORE_CREDENTIALS_FILE=

MCP_RATE_LIMIT_PER_MIN=60
MCP_TOOL_TIMEOUT_MS=10000